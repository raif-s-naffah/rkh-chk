# Unsigned decimal integer, less or equal to 10 indicating the maximum
# allowed value for OFFSET.  Default is 10.
#
MAX_OFFSET=10

# Unsigned decimal integer, less or equal to 3 indicating the maximum number
# of DNF History Info frames we'll fetch earlier than the user-provided OFFSET
# index.  Default is 2.
#
MAX_DNF_DEJA_VU=2

# DNF History frames date-times are expressed in UTC timezone. The tool tries
# to display them in the system's one.  If however it fails to discover that
# name, it will use this default if/set.  If this parameter is missing or is
# misconfigured date-times will be kept in UTC timezone.
#
DEFAULT_SYSTEM_TZ="Australia/Sydney"

## ----- Logging stuff -----

# Log verbosity.  Valid values are: "OFF", "ERROR", "WARN", "INFO", "DEBUG",
# "TRACE". Defaults to "info"
#
RUST_LOG=info

# Whether to output a backtrace when code panics.
#
RUST_BACKTRACE=full
